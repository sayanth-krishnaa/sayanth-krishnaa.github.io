# ==============================================================================
# SUPABASE & PORTFOLIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Obtain these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Secret used for Admin JWT Session verification
JWT_SECRET=super-secure-portfolio-jwt-secret-key-32-chars-long-at-least
